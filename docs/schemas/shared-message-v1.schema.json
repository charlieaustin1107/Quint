{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quint.local/schemas/shared-message-v1.json",
  "title": "Quint Shared Intelligence Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version","message_id","message_type","producer","created_at","expires_at","correlation_id","environment","payload"],
  "properties": {
    "contract_version": {"const":"1.0"},
    "message_id": {"type":"string","minLength":1},
    "message_type": {"type":"string","minLength":1},
    "producer": {"enum":["quint","brain","lab","control"]},
    "created_at": {"type":"string","format":"date-time"},
    "expires_at": {"type":["string","null"],"format":"date-time"},
    "correlation_id": {"type":"string","minLength":1},
    "account_id": {"type":["string","null"]},
    "environment": {"enum":["backtest","simulation","paper","live"]},
    "payload": {"type":"object"}
  }
}