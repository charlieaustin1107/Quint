//@version=6
// Quint · WYLD Four Pillars (v2)
// The owner's strategy (WYLD Will's Four Pillars) marked live on the chart, with an alert at every step:
//   ① Liquidity sweep of a marked 15m pool (equal highs or lows formed before the open). A box marks the wick of the
//     candle that made the last push, with its 50% (WYLD's wick entry) and the trigger line a close must beat.
//   ② Price trades into a higher-timeframe level near the sweep and closes back on the right side: the level is drawn.
//   ③ PDR bias: a box from Point A (the level that held) to Point B (the next HTF level), with 25 / 50 / 75 steps.
//   ④ 1-minute confirmation = the entry: entry and stop lines, Target 1 Point B, Target 2 the opposing liquidity.
// Then: +1R (WYLD moves to break-even), and the stage ends at Point B, on a close through Point A, or at the window's end.
// Pools taken overnight are marked as taken; only a sweep inside the window starts a stage.
// Only the first hours after the 9:30 New York open (14:30 UK). Built for MNQ on the 1-minute chart.
// Quint's mechanical reading of WYLD's rules; where his videos leave a rule open, it's a setting.
// Signals only: it never places orders. Not financial advice. Source: Quint repo, lab/pine/wyld_four_pillars.pine.
indicator("Quint · WYLD Four Pillars", shorttitle = "WYLD 4P", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200)

// ───────── Settings ─────────
const string G1 = "Session"
const string G2 = "① Liquidity (15m equal highs and lows)"
const string G3 = "② and ③ Higher-timeframe levels and the PDR"
const string G4 = "④ Confirmation and the trade"
const string G5 = "Display"
winHours      = input.float(3.0, "Trading window: hours after the 9:30 New York open", minval = 0.5, maxval = 6.5, step = 0.5, group = G1)
swingLen      = input.int(3, "15m swing strength (candles each side)", minval = 1, maxval = 10, group = G2)
eqTicks       = input.int(8, "Equal highs/lows tolerance (ticks)", minval = 1, maxval = 80, group = G2, tooltip = "Two 15m swing highs (or lows) within this many ticks make a liquidity pool. 8 ticks = 2 MNQ points.")
lookbackDays  = input.int(3, "Pools from the last N days", minval = 1, maxval = 10, group = G2)
onlyPremarket = input.bool(true, "Only pools formed before the open (marked pre-market)", group = G2)
usePdPools    = input.bool(false, "Also count prior day high/low as pools", group = G2, tooltip = "WYLD counts only the marked 15m equal highs and lows. Off follows him.")
useOnPools    = input.bool(false, "Also count the overnight high/low as pools", group = G2)
useMonthly    = input.bool(true, "Monthly levels (prior month high/low)", group = G3)
useWeekly     = input.bool(true, "Weekly levels (prior week high/low, NWOG, weekly FVG)", group = G3)
useDaily      = input.bool(true, "Daily levels (prior day high/low, NDOG, daily FVG, wick 50%s)", group = G3)
overlapTicks  = input.int(8, "Drop a lower-timeframe level within (ticks) of a higher one", minval = 0, maxval = 80, group = G3)
reachTicks    = input.int(60, "The level must be within (ticks) of the sweep", minval = 4, maxval = 400, group = G3)
tolTicks      = input.int(4, "Touch tolerance (ticks)", minval = 0, maxval = 40, group = G3)
minPdrTicks   = input.int(40, "Point B at least (ticks) from Point A", minval = 4, maxval = 400, group = G3)
breakTicks    = input.int(8, "PDR broken when a close is (ticks) through Point A", minval = 0, maxval = 80, group = G3)
holdBars      = input.int(30, "A level must hold within (candles) of the sweep", minval = 1, maxval = 240, group = G3)
useWick       = input.bool(true, "Confirm: a wick holds and price closes beyond it", group = G4)
useRetest     = input.bool(true, "Confirm: retest of the HTF level holds", group = G4)
useBreak      = input.bool(true, "Confirm: a held level breaks (close beyond the recent swing)", group = G4)
useIfvg       = input.bool(true, "Confirm: an FVG inverts", group = G4)
useFvgRetest  = input.bool(true, "Confirm: price trades into a new FVG and holds", group = G4)
sbLen         = input.int(5, "Recent swing for the break (candles)", minval = 2, maxval = 50, group = G4)
fvgLook       = input.int(20, "FVG inversion: gaps formed within (candles) of the sweep", minval = 1, maxval = 200, group = G4)
stopBufTicks  = input.int(2, "Stop buffer beyond the wick (ticks)", minval = 0, maxval = 40, group = G4)
minR          = input.float(1.0, "Minimum reward to Point B (R)", minval = 0.0, maxval = 20.0, step = 0.5, group = G4)
maxEntries    = input.int(3, "Entries per stage (WYLD re-enters on each new confirmation)", minval = 1, maxval = 25, group = G4)
reentryBars   = input.int(5, "Candles between entries", minval = 1, maxval = 120, group = G4)
showMarks     = input.bool(true, "Mark each step on the chart (wick box, level, PDR, entry)", group = G5)
showLevels    = input.int(8, "HTF levels to draw (nearest to price)", minval = 0, maxval = 30, group = G5)
showPools     = input.bool(true, "Draw the liquidity pools", group = G5)
boxStyle      = input.string("Small", "Confluence box", options = ["Small", "Detailed", "Off"], group = G5)
boxPosIn      = input.string("Top right", "Confluence box position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G5)
showRegime    = input.bool(true, "Regime table (every timeframe)", group = G5)
regPosIn      = input.string("Bottom right", "Regime table position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G5)
textSizeIn    = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G5)

const color MINT   = #2fd9a8
const color ROSE   = #ff4f6e
const color AMBER  = #ffb547
const color CHROME = #d4d4d4
const color DIM    = #8a8a8a
const color INK    = #000000
const color CLEAR  = #00000000

tk  = syminfo.mintick
txt = textSizeIn == "Tiny" ? size.tiny : textSizeIn == "Normal" ? size.normal : size.small
posOf(string s) => s == "Top left" ? position.top_left : s == "Bottom right" ? position.bottom_right : s == "Bottom left" ? position.bottom_left : position.top_right
fmt(float p) => na(p) ? "—" : str.tostring(p, format.mintick)

// ───────── New York session clock ─────────
nyMin     = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
nyDow     = dayofweek(time, "America/New_York")
weekday   = nyDow >= dayofweek.monday and nyDow <= dayofweek.friday
winEnd    = 570 + int(math.round(winHours * 60))
inWindow  = weekday and nyMin >= 570 and nyMin < winEnd
newWindow = inWindow and not inWindow[1]
winOver   = inWindow[1] and not inWindow
var int winStartTime = na
if newWindow
    winStartTime := time

// overnight (Globex) high and low, 18:00 to 9:30 New York
var float onH = na
var float onL = na
isON = nyMin >= 1080 or nyMin < 570
if isON and not isON[1]
    onH := high
    onL := low
else if isON
    onH := math.max(nz(onH, high), high)
    onL := math.min(nz(onL, low), low)

// ───────── Higher timeframes (completed candles only, so nothing repaints) ─────────
[pdh, pdl, pdo, pdc, dOpen] = request.security(syminfo.tickerid, "D", [high[1], low[1], open[1], close[1], open], lookahead = barmerge.lookahead_on)
[pwh, pwl, wPrevClose, wOpen] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1], open], lookahead = barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

fvgPrev() =>
    var float bTop = na
    var float bBot = na
    var float sTop = na
    var float sBot = na
    if low > high[2]
        bTop := low
        bBot := high[2]
    if high < low[2]
        sTop := low[2]
        sBot := high
    if not na(bBot) and close < bBot
        bTop := na
        bBot := na
    if not na(sTop) and close > sTop
        sTop := na
        sBot := na
    [bTop[1], bBot[1], sTop[1], sBot[1]]
[dBuT, dBuB, dBeT, dBeB] = request.security(syminfo.tickerid, "D", fvgPrev(), lookahead = barmerge.lookahead_on)
[wBuT, wBuB, wBeT, wBeB] = request.security(syminfo.tickerid, "W", fvgPrev(), lookahead = barmerge.lookahead_on)

// Regime of the last completed candle: trend (EMA 20/50 and the 50's slope), volatility (ATR against its average),
// and zone (where price sits in the last 50 candles' range). Context only: WYLD's bias is the PDR, not these.
regimePrev() =>
    e20 = ta.ema(close, 20)
    e50 = ta.ema(close, 50)
    a   = ta.atr(14)
    aa  = ta.sma(a, 50)
    hh  = ta.highest(high, 50)
    ll  = ta.lowest(low, 50)
    int tr = close[1] > e50[1] and e20[1] > e50[1] and e50[1] > e50[6] ? 1 : close[1] < e50[1] and e20[1] < e50[1] and e50[1] < e50[6] ? -1 : 0
    int vo = a[1] > aa[1] * 1.2 ? 1 : a[1] < aa[1] * 0.8 ? -1 : 0
    float zo = hh[1] > ll[1] ? (close[1] - ll[1]) / (hh[1] - ll[1]) : 0.5
    [tr, vo, zo]
[trM, voM, zoM] = request.security(syminfo.tickerid, "M", regimePrev(), lookahead = barmerge.lookahead_on)
[trW, voW, zoW] = request.security(syminfo.tickerid, "W", regimePrev(), lookahead = barmerge.lookahead_on)
[trD, voD, zoD] = request.security(syminfo.tickerid, "D", regimePrev(), lookahead = barmerge.lookahead_on)
[tr4, vo4, zo4] = request.security(syminfo.tickerid, "240", regimePrev(), lookahead = barmerge.lookahead_on)
[tr1H, vo1H, zo1H] = request.security(syminfo.tickerid, "60", regimePrev(), lookahead = barmerge.lookahead_on)
[tr15, vo15, zo15] = request.security(syminfo.tickerid, "15", regimePrev(), lookahead = barmerge.lookahead_on)
[tr5, vo5, zo5] = request.security(syminfo.tickerid, "5", regimePrev(), lookahead = barmerge.lookahead_on)
[tr1, vo1, zo1] = request.security(syminfo.tickerid, "1", regimePrev(), lookahead = barmerge.lookahead_on)

// 15m swing highs and lows, confirmed
[ph15, pl15, ph15t, pl15t] = request.security(syminfo.tickerid, "15", [ta.pivothigh(high, swingLen, swingLen)[1], ta.pivotlow(low, swingLen, swingLen)[1], time[swingLen + 1], time[swingLen + 1]], lookahead = barmerge.lookahead_on)

// ───────── Liquidity pools ─────────
var array<float> swH  = array.new<float>()
var array<int>   swHt = array.new<int>()
var array<float> swL  = array.new<float>()
var array<int>   swLt = array.new<int>()
var array<float> poolP = array.new<float>()
var array<int>   poolD = array.new<int>()   // 1 = buy-side (equal highs), -1 = sell-side (equal lows)
var array<int>   poolT = array.new<int>()
var array<bool>  poolSwept = array.new<bool>()
var array<int>   poolN = array.new<int>()
lookMs = lookbackDays * 86400000

addPool(float level, int dir, int t) =>
    bool merged = false
    int n = array.size(poolP)
    if n > 0
        for i = 0 to n - 1
            if array.get(poolD, i) == dir and not array.get(poolSwept, i) and math.abs(array.get(poolP, i) - level) <= eqTicks * syminfo.mintick
                array.set(poolP, i, dir == 1 ? math.max(array.get(poolP, i), level) : math.min(array.get(poolP, i), level))
                array.set(poolN, i, array.get(poolN, i) + 1)
                merged := true
                break
    if not merged
        array.push(poolP, level)
        array.push(poolD, dir)
        array.push(poolT, t)
        array.push(poolSwept, false)
        array.push(poolN, 2)
        if array.size(poolP) > 60
            array.shift(poolP)
            array.shift(poolD)
            array.shift(poolT)
            array.shift(poolSwept)
            array.shift(poolN)
    merged

addSwing(array<float> px, array<int> tx, float p, int t, int dir) =>
    int n = array.size(px)
    if n > 0
        int stopAt = math.max(0, n - 12)
        for i = n - 1 to stopAt
            float q = array.get(px, i)
            if math.abs(p - q) <= eqTicks * syminfo.mintick and t - array.get(tx, i) <= lookMs
                addPool(dir == 1 ? math.max(p, q) : math.min(p, q), dir, t)
                break
    array.push(px, p)
    array.push(tx, t)
    if array.size(px) > 40
        array.shift(px)
        array.shift(tx)
    n

var int lastPhT = na
var int lastPlT = na
if not na(ph15) and (na(lastPhT) or ph15t != lastPhT)
    lastPhT := ph15t
    addSwing(swH, swHt, ph15, ph15t, 1)
if not na(pl15) and (na(lastPlT) or pl15t != lastPlT)
    lastPlT := pl15t
    addSwing(swL, swLt, pl15, pl15t, -1)
if newWindow
    if usePdPools
        addPool(pdl, -1, time - 60000)
        addPool(pdh, 1, time - 60000)
    if useOnPools
        addPool(onL, -1, time - 60000)
        addPool(onH, 1, time - 60000)

poolEligible(int i) =>
    int pt = array.get(poolT, i)
    bool fresh = time - pt <= lookMs
    bool pre = not onlyPremarket or (not na(winStartTime) and pt <= winStartTime)
    fresh and pre

// Pools taken on this candle, at any hour. Only a sweep inside the window can start a stage, so a pool that was run
// overnight is already taken by the open (WYLD: note whether either side has already been swept).
var array<float> takenLo = array.new<float>()
var array<int>   takenLoN = array.new<int>()
var array<float> takenHi = array.new<float>()
var array<int>   takenHiN = array.new<int>()
array.clear(takenLo)
array.clear(takenLoN)
array.clear(takenHi)
array.clear(takenHiN)
int npl = array.size(poolP)
if npl > 0
    for i = 0 to npl - 1
        if not array.get(poolSwept, i)
            float p = array.get(poolP, i)
            int dr = array.get(poolD, i)
            if dr == -1 ? low < p : high > p
                array.set(poolSwept, i, true)
                if inWindow and poolEligible(i)
                    if dr == -1
                        array.push(takenLo, p)
                        array.push(takenLoN, array.get(poolN, i))
                    else
                        array.push(takenHi, p)
                        array.push(takenHiN, array.get(poolN, i))

// ───────── Higher-timeframe levels: monthly first, then weekly, then daily; a lower one that overlaps a higher one is dropped ─────────
var array<float>  lvP = array.new<float>()
var array<string> lvN = array.new<string>()
var array<int>    lvR = array.new<int>()
array.clear(lvP)
array.clear(lvN)
array.clear(lvR)
addLevel(float p, string name, int rank) =>
    bool dup = false
    if not na(p)
        int n = array.size(lvP)
        if n > 0
            for i = 0 to n - 1
                if math.abs(array.get(lvP, i) - p) <= overlapTicks * syminfo.mintick
                    dup := true
                    break
        if not dup
            array.push(lvP, p)
            array.push(lvN, name)
            array.push(lvR, rank)
    dup
if useMonthly
    addLevel(pmh, "Prior month high", 3)
    addLevel(pml, "Prior month low", 3)
if useWeekly
    addLevel(pwh, "Prior week high", 2)
    addLevel(pwl, "Prior week low", 2)
    if math.abs(wOpen - wPrevClose) >= 2 * tk
        addLevel(math.max(wOpen, wPrevClose), "NWOG top", 2)
        addLevel(math.min(wOpen, wPrevClose), "NWOG bottom", 2)
    addLevel(wBuT, "Weekly FVG top", 2)
    addLevel(na(wBuT) ? na : (wBuT + wBuB) / 2, "Weekly FVG 50%", 2)
    addLevel(wBuB, "Weekly FVG bottom", 2)
    addLevel(wBeT, "Weekly FVG top", 2)
    addLevel(na(wBeT) ? na : (wBeT + wBeB) / 2, "Weekly FVG 50%", 2)
    addLevel(wBeB, "Weekly FVG bottom", 2)
if useDaily
    addLevel(pdh, "Prior day high", 1)
    addLevel(pdl, "Prior day low", 1)
    if math.abs(dOpen - pdc) >= 2 * tk
        addLevel(math.max(dOpen, pdc), "NDOG top", 1)
        addLevel(math.min(dOpen, pdc), "NDOG bottom", 1)
    addLevel(dBuT, "Daily FVG top", 1)
    addLevel(na(dBuT) ? na : (dBuT + dBuB) / 2, "Daily FVG 50%", 1)
    addLevel(dBuB, "Daily FVG bottom", 1)
    addLevel(dBeT, "Daily FVG top", 1)
    addLevel(na(dBeT) ? na : (dBeT + dBeB) / 2, "Daily FVG 50%", 1)
    addLevel(dBeB, "Daily FVG bottom", 1)
    addLevel(pdh - (pdh - math.max(pdo, pdc)) / 2, "Prior day upper wick 50%", 1)
    addLevel(pdl + (math.min(pdo, pdc) - pdl) / 2, "Prior day lower wick 50%", 1)

// ───────── Chart fair value gaps and the recent swing (for confirmations) ─────────
var float cfBuT = na
var float cfBuB = na
var int   cfBuBar = na
var float cfBeT = na
var float cfBeB = na
var int   cfBeBar = na
if low > high[2]
    cfBuT := low
    cfBuB := high[2]
    cfBuBar := bar_index
if high < low[2]
    cfBeT := low[2]
    cfBeB := high
    cfBeBar := bar_index
hhPrev = ta.highest(high, sbLen)[1]
llPrev = ta.lowest(low, sbLen)[1]
lo3 = math.min(low, math.min(low[1], low[2]))
hi3 = math.max(high, math.max(high[1], high[2]))

// ───────── One stage per direction, with its marks on the chart ─────────
type Stage
    int    dir
    int    step = 0
    float  pool = na
    int    poolTouches = 0
    float  extreme = na
    int    extremeBar = na
    float  wickEdge = na
    int    sweepBar = na
    int    sweepTime = na
    float  pointA = na
    string aName = ""
    int    aRank = 0
    float  pointB = na
    string bName = ""
    float  t2 = na
    int    heldBar = na
    int    entries = 0
    int    lastEntryBar = na
    float  entry = na
    float  stop = na
    bool   beSent = false
    bool   usedWick = false
    bool   usedBreak = false
    string conf = ""
    string last = ""
    box    wickBox
    line   wickMid
    line   trigLine
    label  lb1
    label  lbTrig
    line   aLine
    label  lb2
    box    pdrBox
    line   q25
    line   q50
    line   q75
    line   t2Line
    label  lb3
    line   eLine
    line   sLine

endLine(line l) =>
    if not na(l)
        line.set_extend(l, extend.none)
        line.set_x2(l, bar_index)
    l
endBox(box b) =>
    if not na(b)
        box.set_extend(b, extend.none)
        box.set_right(b, bar_index)
    b

// Stop the stage's marks at this candle (they stay on the chart as a record) and say how it ended.
method finishStage(Stage s, string outcome, color col) =>
    endBox(s.wickBox)
    endLine(s.wickMid)
    endLine(s.trigLine)
    endLine(s.aLine)
    endBox(s.pdrBox)
    endLine(s.q25)
    endLine(s.q50)
    endLine(s.q75)
    endLine(s.t2Line)
    endLine(s.eLine)
    endLine(s.sLine)
    if showMarks and outcome != "" and s.step > 0
        label.new(bar_index, s.dir == 1 ? high : low, outcome, color = CLEAR, textcolor = col, style = s.dir == 1 ? label.style_label_down : label.style_label_up, size = size.small)
    s

method clearStage(Stage s) =>
    s.step := 0
    s.pool := na
    s.poolTouches := 0
    s.extreme := na
    s.extremeBar := na
    s.wickEdge := na
    s.sweepBar := na
    s.sweepTime := na
    s.pointA := na
    s.aName := ""
    s.aRank := 0
    s.pointB := na
    s.bName := ""
    s.t2 := na
    s.heldBar := na
    s.entries := 0
    s.lastEntryBar := na
    s.entry := na
    s.stop := na
    s.beSent := false
    s.usedWick := false
    s.usedBreak := false
    s.conf := ""
    s.wickBox := na
    s.wickMid := na
    s.trigLine := na
    s.lb1 := na
    s.lbTrig := na
    s.aLine := na
    s.lb2 := na
    s.pdrBox := na
    s.q25 := na
    s.q50 := na
    s.q75 := na
    s.t2Line := na
    s.lb3 := na
    s.eLine := na
    s.sLine := na
    s

join(string a, string b) => a == "" ? b : a + "  ·  " + b

// The wick of the candle that made the last push: for a long, from its low up to its body; for a short, from its body up
// to its high. Its 50% is WYLD's wick entry. The trigger is the far end of that candle: a close beyond it confirms.
method markWick(Stage s) =>
    int d = s.dir
    float wTop = d == 1 ? math.min(open, close) : high
    float wBot = d == 1 ? low : math.max(open, close)
    float mid = (wTop + wBot) / 2
    float trig = d == 1 ? high : low
    color c = d == 1 ? MINT : ROSE
    if showMarks
        if na(s.wickBox)
            s.wickBox := box.new(bar_index, wTop, bar_index + 1, wBot, border_color = color.new(AMBER, 20), bgcolor = color.new(AMBER, 82), extend = extend.right)
            s.wickMid := line.new(bar_index, mid, bar_index + 1, mid, extend = extend.right, color = AMBER, style = line.style_dotted)
            s.trigLine := line.new(bar_index, trig, bar_index + 1, trig, extend = extend.right, color = color.new(CHROME, 25), style = line.style_dashed)
            s.lb1 := label.new(bar_index, d == 1 ? low : high, "① sweep " + fmt(s.pool), color = CLEAR, textcolor = c, style = d == 1 ? label.style_label_up : label.style_label_down, size = size.small)
            s.lbTrig := label.new(bar_index, trig, "④ trigger: close " + (d == 1 ? "above " : "below ") + fmt(trig) + " · wick 50% " + fmt(mid), color = CLEAR, textcolor = color.new(CHROME, 20), style = label.style_label_left, size = size.tiny)
        else
            box.set_lefttop(s.wickBox, bar_index, wTop)
            box.set_rightbottom(s.wickBox, bar_index + 1, wBot)
            line.set_xy1(s.wickMid, bar_index, mid)
            line.set_xy2(s.wickMid, bar_index + 1, mid)
            line.set_xy1(s.trigLine, bar_index, trig)
            line.set_xy2(s.trigLine, bar_index + 1, trig)
            label.set_xy(s.lb1, bar_index, d == 1 ? low : high)
            label.set_xy(s.lbTrig, bar_index, trig)
            label.set_text(s.lbTrig, "④ trigger: close " + (d == 1 ? "above " : "below ") + fmt(trig) + " · wick 50% " + fmt(mid))
    s

runStage(Stage s) =>
    bool e1 = false
    bool e2 = false
    bool e3 = false
    bool e4 = false
    bool eBE = false
    bool eEnd = false
    string msg = ""
    int d = s.dir
    string side = d == 1 ? "LONG" : "SHORT"
    color c = d == 1 ? MINT : ROSE
    float tol = tolTicks * syminfo.mintick
    // ① a marked pool on the other side is swept inside the window
    if s.step == 0 and inWindow
        float best = na
        int bestN = 0
        array<float> tp = takenHi
        array<int> tn = takenHiN
        if d == 1
            tp := takenLo
            tn := takenLoN
        int n = array.size(tp)
        if n > 0
            for i = 0 to n - 1
                float p = array.get(tp, i)
                if na(best) or (d == 1 ? p < best : p > best)
                    best := p
                    bestN := array.get(tn, i)
        if not na(best)
            s.step := 1
            s.pool := best
            s.poolTouches := bestN
            s.extreme := d == 1 ? low : high
            s.extremeBar := bar_index
            s.wickEdge := d == 1 ? high : low
            s.sweepBar := bar_index
            s.sweepTime := time
            s.markWick()
            e1 := true
            msg := join(msg, "① SWEEP (" + side + " stage): " + (d == 1 ? "sell-side equal lows " : "buy-side equal highs ") + fmt(best) + " taken. Wick box drawn. Now wait for an HTF level to hold.")
    // ② a higher-timeframe level near the sweep holds
    if s.step == 1
        if bar_index > s.extremeBar and (d == 1 ? low < s.extreme : high > s.extreme)
            s.extreme := d == 1 ? low : high
            s.extremeBar := bar_index
            s.wickEdge := d == 1 ? high : low
            s.markWick()
        float A = na
        string aN = ""
        int aR = 0
        int m = array.size(lvP)
        if m > 0
            for i = 0 to m - 1
                float lv = array.get(lvP, i)
                bool near = math.abs(lv - s.extreme) <= reachTicks * syminfo.mintick
                bool held = d == 1 ? low <= lv + tol and close > lv : high >= lv - tol and close < lv
                if near and held and (na(A) or (d == 1 ? lv > A : lv < A))
                    A := lv
                    aN := array.get(lvN, i)
                    aR := array.get(lvR, i)
        if not na(A)
            s.step := 2
            s.pointA := A
            s.aName := aN
            s.aRank := aR
            s.heldBar := bar_index
            if showMarks
                s.aLine := line.new(bar_index, A, bar_index + 1, A, extend = extend.right, color = c, width = 2)
                s.lb2 := label.new(bar_index, A, "② " + aN + " " + fmt(A) + " held", color = CLEAR, textcolor = c, style = label.style_label_left, size = size.small)
            e2 := true
            msg := join(msg, "② HTF LEVEL HOLDS (" + side + "): " + aN + " " + fmt(A) + ".")
        else if bar_index - s.sweepBar > holdBars or not inWindow
            msg := join(msg, "Stage dropped: no HTF level held after the sweep.")
            s.finishStage("no level held", DIM)
            s.clearStage()
    // ③ the PDR: Point A to the next HTF level, Point B
    if s.step == 2
        float B = na
        string bN = ""
        int m = array.size(lvP)
        if m > 0
            for i = 0 to m - 1
                float lv = array.get(lvP, i)
                if (d == 1 ? lv > s.pointA + minPdrTicks * syminfo.mintick : lv < s.pointA - minPdrTicks * syminfo.mintick) and (na(B) or (d == 1 ? lv < B : lv > B))
                    B := lv
                    bN := array.get(lvN, i)
        float T2 = na
        int n = array.size(poolP)
        if n > 0
            for i = 0 to n - 1
                float p = array.get(poolP, i)
                if array.get(poolD, i) == d and not array.get(poolSwept, i) and (d == 1 ? p > s.pointA + minPdrTicks * syminfo.mintick : p < s.pointA - minPdrTicks * syminfo.mintick)
                    if na(B)
                        B := p
                        bN := d == 1 ? "Equal highs" : "Equal lows"
                    else if (d == 1 ? p > B : p < B) and (na(T2) or (d == 1 ? p < T2 : p > T2))
                        T2 := p
        if na(B)
            msg := join(msg, "Stage dropped: no Point B (no HTF level or liquidity beyond Point A).")
            s.finishStage("no Point B", DIM)
            s.clearStage()
        else
            if na(T2) and m > 0
                for i = 0 to m - 1
                    float lv = array.get(lvP, i)
                    if (d == 1 ? lv > B + tol : lv < B - tol) and (na(T2) or (d == 1 ? lv < T2 : lv > T2))
                        T2 := lv
            s.pointB := B
            s.bName := bN
            s.t2 := T2
            s.step := 3
            float mid = (s.pointA + B) / 2
            if showMarks
                s.pdrBox := box.new(bar_index, math.max(s.pointA, B), bar_index + 1, math.min(s.pointA, B), border_color = color.new(CHROME, 70), bgcolor = color.new(CHROME, 93), extend = extend.right)
                s.q25 := line.new(bar_index, s.pointA + (B - s.pointA) * 0.25, bar_index + 1, s.pointA + (B - s.pointA) * 0.25, extend = extend.right, color = color.new(CHROME, 65), style = line.style_dotted)
                s.q50 := line.new(bar_index, mid, bar_index + 1, mid, extend = extend.right, color = color.new(CHROME, 30), style = line.style_dashed)
                s.q75 := line.new(bar_index, s.pointA + (B - s.pointA) * 0.75, bar_index + 1, s.pointA + (B - s.pointA) * 0.75, extend = extend.right, color = color.new(CHROME, 65), style = line.style_dotted)
                s.lb3 := label.new(bar_index, B, "③ B " + bN + " " + fmt(B) + " · 0.5 " + fmt(mid), color = CLEAR, textcolor = CHROME, style = label.style_label_left, size = size.small)
                if not na(T2)
                    s.t2Line := line.new(bar_index, T2, bar_index + 1, T2, extend = extend.right, color = color.new(c, 45), style = line.style_dashed)
            e3 := true
            msg := join(msg, "③ PDR BIAS " + side + ": A " + fmt(s.pointA) + " → B " + fmt(B) + " (" + bN + "), 0.5 at " + fmt(mid) + ". Stage set: wait for the 1m confirmation.")
    // ④ the stage is set: confirmations, management, the end of the stage
    if s.step == 3
        bool reachedB = d == 1 ? high >= s.pointB : low <= s.pointB
        bool broken = d == 1 ? close < s.pointA - breakTicks * syminfo.mintick : close > s.pointA + breakTicks * syminfo.mintick
        if not na(s.entry) and not s.beSent and (d == 1 ? high >= s.entry + (s.entry - s.stop) : low <= s.entry - (s.stop - s.entry))
            s.beSent := true
            eBE := true
            if showMarks
                label.new(bar_index, d == 1 ? high : low, "+1R · BE", color = CLEAR, textcolor = AMBER, style = d == 1 ? label.style_label_down : label.style_label_up, size = size.small)
            msg := join(msg, "+1R on the " + side + " from " + fmt(s.entry) + ": WYLD moves the stop to break-even.")
        if reachedB or broken
            eEnd := true
            msg := join(msg, reachedB ? "STAGE COMPLETE: Point B " + fmt(s.pointB) + " reached. Next: the opposing liquidity " + fmt(s.t2) + " if you're still in." : "PDR BROKEN: price closed through Point A " + fmt(s.pointA) + ". The stage is over.")
            s.finishStage(reachedB ? "✓ B reached" : "✗ PDR broken", reachedB ? MINT : ROSE)
            s.clearStage()
        else if inWindow and s.entries < maxEntries and bar_index > s.heldBar and (na(s.lastEntryBar) or bar_index - s.lastEntryBar >= reentryBars)
            string cf = ""
            if useWick and not s.usedWick and bar_index > s.extremeBar and (d == 1 ? close > s.wickEdge : close < s.wickEdge)
                cf := "a wick held and price closed beyond it"
            if cf == "" and useRetest and (d == 1 ? low <= s.pointA + tol and close > s.pointA : high >= s.pointA - tol and close < s.pointA)
                cf := "the HTF level retest held"
            if cf == "" and useBreak and not s.usedBreak and (d == 1 ? close > hhPrev : close < llPrev)
                cf := "a held level broke (close beyond the recent swing)"
            if cf == "" and useIfvg and (d == 1 ? not na(cfBeT) and cfBeBar >= s.sweepBar - fvgLook and close > cfBeT : not na(cfBuB) and cfBuBar >= s.sweepBar - fvgLook and close < cfBuB)
                cf := "an FVG inverted"
            if cf == "" and useFvgRetest and (d == 1 ? not na(cfBuT) and cfBuBar > s.heldBar and cfBuBar < bar_index and low <= cfBuT and close > cfBuB : not na(cfBeB) and cfBeBar > s.heldBar and cfBeBar < bar_index and high >= cfBeB and close < cfBeT)
                cf := "price traded into a new FVG and held"
            if cf != ""
                float entry = close
                float stopP = d == 1 ? lo3 - stopBufTicks * syminfo.mintick : hi3 + stopBufTicks * syminfo.mintick
                float risk = math.abs(entry - stopP)
                bool room = d == 1 ? entry < s.pointB : entry > s.pointB
                float rB = risk > 0 ? math.abs(s.pointB - entry) / risk : 0.0
                if risk > 0 and room and rB >= minR
                    s.entries := s.entries + 1
                    s.lastEntryBar := bar_index
                    s.entry := entry
                    s.stop := stopP
                    s.beSent := false
                    s.conf := cf
                    if str.contains(cf, "wick")
                        s.usedWick := true
                    if str.contains(cf, "broke")
                        s.usedBreak := true
                    e4 := true
                    if showMarks
                        endLine(s.eLine)
                        endLine(s.sLine)
                        s.eLine := line.new(bar_index, entry, bar_index + 1, entry, extend = extend.right, color = color.new(c, 20))
                        s.sLine := line.new(bar_index, stopP, bar_index + 1, stopP, extend = extend.right, color = color.new(ROSE, 20), style = line.style_dashed)
                    string t2s = na(s.t2) ? "" : " · T2 opposing liquidity " + fmt(s.t2) + " (" + str.tostring(math.abs(s.t2 - entry) / risk, "#.#") + "R)"
                    msg := join(msg, "④ ENTRY " + side + " #" + str.tostring(s.entries) + ": " + cf + ". Entry " + fmt(entry) + " · stop " + fmt(stopP) + " (" + str.tostring(risk / syminfo.mintick, "#") + " ticks) · T1 Point B " + fmt(s.pointB) + " (" + str.tostring(rB, "#.#") + "R)" + t2s + ".")
                    label.new(bar_index, d == 1 ? low : high, "④ " + (d == 1 ? "BUY " : "SELL ") + str.tostring(rB, "#.#") + "R\n" + cf, color = c, textcolor = INK, style = d == 1 ? label.style_label_up : label.style_label_down, size = size.small)
    s.last := msg == "" ? s.last : msg
    [e1, e2, e3, e4, eBE, eEnd, msg]

var Stage L = Stage.new(dir = 1)
var Stage S = Stage.new(dir = -1)
[l1, l2, l3, l4, lBE, lEnd, lMsg] = runStage(L)
[s1, s2, s3, s4, sBE, sEnd, sMsg] = runStage(S)
bool expired = false
if winOver and (L.step > 0 or S.step > 0)
    expired := true
    L.finishStage("window closed", DIM)
    S.finishStage("window closed", DIM)
    L.clearStage()
    S.clearStage()

// ───────── Alerts: one alert with "Any alert() function call" gets every step with its prices ─────────
if lMsg != ""
    alert(syminfo.ticker + " · " + lMsg, alert.freq_once_per_bar_close)
if sMsg != ""
    alert(syminfo.ticker + " · " + sMsg, alert.freq_once_per_bar_close)
if expired
    alert(syminfo.ticker + " · Window closed: the open stage expired. No new trades today (WYLD trades the first hours only).", alert.freq_once_per_bar_close)
alertcondition(l1 or s1, "① Sweep", "WYLD 4P: a marked liquidity pool was swept")
alertcondition(l2 or s2, "② HTF level holds", "WYLD 4P: an HTF level held after the sweep")
alertcondition(l3 or s3, "③ PDR bias set", "WYLD 4P: PDR bias set, waiting for the 1m confirmation")
alertcondition(l4 or s4, "④ Entry (1m confirmation)", "WYLD 4P: ENTRY on the 1m confirmation")
alertcondition(lBE or sBE, "+1R break-even", "WYLD 4P: +1R, move the stop to break-even")
alertcondition(lEnd or sEnd or expired, "Stage over", "WYLD 4P: the stage is complete, broken or expired")
bgcolor(inWindow ? color.new(CHROME, 96) : na, title = "Trading window")

// HTF levels and pools nearest to price, redrawn on the last candle
var array<line>  drawnLines  = array.new<line>()
var array<label> drawnLabels = array.new<label>()
if barstate.islast
    while array.size(drawnLines) > 0
        line.delete(array.pop(drawnLines))
    while array.size(drawnLabels) > 0
        label.delete(array.pop(drawnLabels))
    int m = array.size(lvP)
    if showLevels > 0 and m > 0
        array<bool> used = array.new<bool>(m, false)
        for k = 1 to math.min(showLevels, m)
            int pick = -1
            float bestD = na
            for i = 0 to m - 1
                float dist = math.abs(array.get(lvP, i) - close)
                if not array.get(used, i) and (na(bestD) or dist < bestD)
                    bestD := dist
                    pick := i
            if pick >= 0
                array.set(used, pick, true)
                float p = array.get(lvP, pick)
                int r = array.get(lvR, pick)
                color lc = r == 3 ? CHROME : r == 2 ? color.new(CHROME, 30) : color.new(CHROME, 55)
                array.push(drawnLines, line.new(bar_index - 40, p, bar_index, p, extend = extend.right, color = lc, style = line.style_dotted, width = r == 3 ? 2 : 1))
                array.push(drawnLabels, label.new(bar_index + 3, p, array.get(lvN, pick) + "  " + fmt(p), style = label.style_none, textcolor = lc, size = size.tiny, textalign = text.align_left))
    int np = array.size(poolP)
    if showPools and np > 0
        for i = 0 to np - 1
            if not array.get(poolSwept, i) and time - array.get(poolT, i) <= lookMs
                float p = array.get(poolP, i)
                int dr = array.get(poolD, i)
                color pc = dr == 1 ? color.new(ROSE, 20) : color.new(MINT, 20)
                array.push(drawnLines, line.new(bar_index - 25, p, bar_index, p, extend = extend.right, color = pc, style = line.style_dashed))
                array.push(drawnLabels, label.new(bar_index + 3, p, (dr == 1 ? "EQH" : "EQL") + " ×" + str.tostring(array.get(poolN, i)) + "  " + fmt(p), style = label.style_none, textcolor = pc, size = size.tiny, textalign = text.align_left))

// ───────── The confluence box (small by default) ─────────
nearestPool(int dir) =>
    float best = na
    int n = array.size(poolP)
    if n > 0
        for i = 0 to n - 1
            float p = array.get(poolP, i)
            if array.get(poolD, i) == dir and not array.get(poolSwept, i) and poolEligible(i) and (dir == 1 ? p > close : p < close) and (na(best) or math.abs(p - close) < math.abs(best - close))
                best := p
    best

trendTxt(int t) => t == 1 ? "▲ Bull" : t == -1 ? "▼ Bear" : "■ Range"
trendCol(int t) => t == 1 ? MINT : t == -1 ? ROSE : AMBER
volTxt(int v) => v == 1 ? "Expanding" : v == -1 ? "Quiet" : "Normal"
zoneTxt(float z) => na(z) ? "—" : z >= 0.6 ? "Premium " + str.tostring(math.round(z * 100)) + "%" : z <= 0.4 ? "Discount " + str.tostring(math.round(z * 100)) + "%" : "Middle " + str.tostring(math.round(z * 100)) + "%"
mark(bool ok) => ok ? "✓ " : "· "

var table conf = table.new(posOf(boxPosIn), 2, 11, bgcolor = color.new(INK, 5), frame_color = color.new(CHROME, 60), frame_width = 1, border_color = color.new(CHROME, 85), border_width = 1)
var table reg = table.new(posOf(regPosIn), 4, 10, bgcolor = color.new(INK, 5), frame_color = color.new(CHROME, 60), frame_width = 1, border_color = color.new(CHROME, 85), border_width = 1)

cell(table t, int c, int r, string s, color col) =>
    table.cell(t, c, r, s, text_color = col, text_size = txt, text_halign = text.align_left)

if barstate.islast and boxStyle != "Off"
    table.clear(conf, 0, 0, 1, 10)
    Stage st = L
    if S.step > L.step
        st := S
    bool active = st.step > 0
    int d = st.dir
    string side = d == 1 ? "LONG" : "SHORT"
    int left = winEnd - nyMin
    float mid = st.step >= 3 ? (st.pointA + st.pointB) / 2 : na
    bool cAbove = st.step >= 3 and (d == 1 ? close > mid : close < mid)
    bool cRank = st.aRank >= 2
    bool cPool = st.poolTouches >= 3
    bool c1H = tr1H == d
    bool c15 = tr15 == d
    bool cVol = vo5 != -1
    int score = (cAbove ? 1 : 0) + (cRank ? 1 : 0) + (cPool ? 1 : 0) + (c1H ? 1 : 0) + (c15 ? 1 : 0) + (cVol ? 1 : 0)
    string status = not weekday ? "Weekend" : not inWindow ? "Outside window" : st.step == 0 ? "Wait for ①" : st.step == 1 ? "Wait for ②" : st.step == 2 ? "Level held" : not na(st.entry) ? "In play " + side : "Wait for ④"
    color sCol = not inWindow ? DIM : st.step >= 3 ? MINT : st.step > 0 ? AMBER : CHROME
    if boxStyle == "Small"
        cell(conf, 0, 0, "WYLD 4P", CHROME)
        cell(conf, 1, 0, status, sCol)
        cell(conf, 0, 1, mark(st.step >= 1) + "①", st.step >= 1 ? MINT : DIM)
        cell(conf, 1, 1, st.step >= 1 ? (d == 1 ? "EQL " : "EQH ") + fmt(st.pool) : "EQH " + fmt(nearestPool(1)) + " · EQL " + fmt(nearestPool(-1)), st.step >= 1 ? CHROME : DIM)
        cell(conf, 0, 2, mark(st.step >= 2) + "②", st.step >= 2 ? MINT : DIM)
        cell(conf, 1, 2, st.step >= 2 ? st.aName + " " + fmt(st.pointA) : "—", st.step >= 2 ? CHROME : DIM)
        cell(conf, 0, 3, mark(st.step >= 3) + "③", st.step >= 3 ? MINT : DIM)
        cell(conf, 1, 3, st.step >= 3 ? "B " + fmt(st.pointB) + " · 0.5 " + fmt(mid) : "—", st.step >= 3 ? CHROME : DIM)
        cell(conf, 0, 4, mark(not na(st.entry)) + "④", not na(st.entry) ? MINT : DIM)
        cell(conf, 1, 4, not na(st.entry) ? "Entry " + fmt(st.entry) + " · stop " + fmt(st.stop) : st.step >= 3 ? "Watch the trigger" : "—", not na(st.entry) ? CHROME : DIM)
        cell(conf, 0, 5, "Score", DIM)
        cell(conf, 1, 5, active ? str.tostring(score) + "/6 extras" : (inWindow ? str.tostring(math.floor(left / 60)) + "h " + str.tostring(left % 60) + "m left" : "14:30 UK"), active ? (score >= 4 ? MINT : score >= 2 ? AMBER : ROSE) : DIM)
    else
        cell(conf, 0, 0, "WYLD FOUR PILLARS", CHROME)
        cell(conf, 1, 0, status, sCol)
        cell(conf, 0, 1, "Window", DIM)
        cell(conf, 1, 1, inWindow ? str.tostring(math.floor(left / 60)) + "h " + str.tostring(left % 60) + "m left" : "First " + str.tostring(winHours) + "h after 9:30 NY (14:30 UK)", inWindow ? MINT : DIM)
        cell(conf, 0, 2, mark(st.step >= 1) + "① Sweep", st.step >= 1 ? MINT : DIM)
        cell(conf, 1, 2, st.step >= 1 ? (d == 1 ? "Equal lows " : "Equal highs ") + fmt(st.pool) + " taken (" + str.tostring(st.poolTouches) + " touches)" : "Pools: EQH " + fmt(nearestPool(1)) + " · EQL " + fmt(nearestPool(-1)), st.step >= 1 ? CHROME : DIM)
        cell(conf, 0, 3, mark(st.step >= 2) + "② HTF level holds", st.step >= 2 ? MINT : DIM)
        cell(conf, 1, 3, st.step >= 2 ? st.aName + " " + fmt(st.pointA) : "Waiting", st.step >= 2 ? CHROME : DIM)
        cell(conf, 0, 4, mark(st.step >= 3) + "③ PDR bias", st.step >= 3 ? MINT : DIM)
        cell(conf, 1, 4, st.step >= 3 ? side + ": A " + fmt(st.pointA) + " → B " + fmt(st.pointB) + " · 0.5 " + fmt(mid) : "Waiting", st.step >= 3 ? CHROME : DIM)
        cell(conf, 0, 5, mark(not na(st.entry)) + "④ 1m confirmation", not na(st.entry) ? MINT : DIM)
        cell(conf, 1, 5, not na(st.entry) ? st.conf + " (entry " + str.tostring(st.entries) + " of " + str.tostring(maxEntries) + ")" : st.step >= 3 ? "Watch the trigger line" : "Waiting", not na(st.entry) ? CHROME : DIM)
        float risk = na(st.entry) ? na : math.abs(st.entry - st.stop)
        cell(conf, 0, 6, "Plan", DIM)
        cell(conf, 1, 6, na(st.entry) ? (st.step >= 3 ? "T1 Point B " + fmt(st.pointB) + " · T2 " + fmt(st.t2) : "—") : "Entry " + fmt(st.entry) + " · stop " + fmt(st.stop) + " · T1 " + fmt(st.pointB) + " (" + str.tostring(math.abs(st.pointB - st.entry) / risk, "#.#") + "R) · T2 " + fmt(st.t2), CHROME)
        cell(conf, 0, 7, "Confluence " + (active ? str.tostring(score) + "/6" : "—"), active ? (score >= 4 ? MINT : score >= 2 ? AMBER : ROSE) : DIM)
        cell(conf, 1, 7, active ? mark(cAbove) + "past the 0.5  " + mark(cRank) + "weekly/monthly level  " + mark(cPool) + "3+ touch pool" : "Extras, not rules: the four pillars decide", active ? CHROME : DIM)
        cell(conf, 0, 8, "", DIM)
        cell(conf, 1, 8, active ? mark(c1H) + "1H trend agrees  " + mark(c15) + "15m trend agrees  " + mark(cVol) + "5m not quiet" : "", CHROME)
        cell(conf, 0, 9, "Last", DIM)
        cell(conf, 1, 9, st.last == "" ? "—" : str.substring(st.last, 0, math.min(str.length(st.last), 120)), DIM)
        cell(conf, 0, 10, "Check", AMBER)
        cell(conf, 1, 10, "Red-folder news? Lucid: flat 1 min either side. Hold winners past 5s.", AMBER)

if barstate.islast and showRegime
    cell(reg, 0, 0, "TF", DIM)
    cell(reg, 1, 0, "Trend", DIM)
    cell(reg, 2, 0, "Volatility", DIM)
    cell(reg, 3, 0, "Zone (50 candles)", DIM)
    int chartSec = timeframe.in_seconds()
    array<string> names = array.from("Monthly", "Weekly", "Daily", "4H", "1H", "15m", "5m", "1m")
    array<int> secs = array.from(2628000, 604800, 86400, 14400, 3600, 900, 300, 60)
    array<int> trs = array.from(trM, trW, trD, tr4, tr1H, tr15, tr5, tr1)
    array<int> vos = array.from(voM, voW, voD, vo4, vo1H, vo15, vo5, vo1)
    array<float> zos = array.from(zoM, zoW, zoD, zo4, zo1H, zo15, zo5, zo1)
    for i = 0 to 7
        bool lower = array.get(secs, i) < chartSec
        int t = array.get(trs, i)
        cell(reg, 0, i + 1, array.get(names, i), CHROME)
        cell(reg, 1, i + 1, lower ? "use a lower chart" : trendTxt(t), lower ? DIM : trendCol(t))
        cell(reg, 2, i + 1, lower ? "" : volTxt(array.get(vos, i)), array.get(vos, i) == 1 ? AMBER : DIM)
        cell(reg, 3, i + 1, lower ? "" : zoneTxt(array.get(zos, i)), DIM)
    cell(reg, 0, 9, "Context only", DIM)
    cell(reg, 1, 9, "WYLD's bias is the PDR, not these", DIM)
