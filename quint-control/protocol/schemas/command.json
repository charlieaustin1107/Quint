    "v": {
      "$ref": "common.json#/$defs/version"
    },
    "type": {
      "const": "command"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "ts": {
      "$ref": "common.json#/$defs/ts"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "description": "Raises risk: the engine replies needs_confirm first. On a prop account it also needs typedConfirm = the account name if the bot is live.",
          "properties": {
            "name": {
              "const": "bot.start"
            },
            "args": {
              "type": "object",
              "properties": {
                "botId": {
                  "$ref": "common.json#/$defs/botId"
                }
              },
              "required": [
                "botId"
              ],
              "additionalProperties": false
            },
            "confirmToken": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            },
            "typedConfirm": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        {
          "type": "object",
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false,
          "description": "Lowers risk: runs at once, no confirm.",
