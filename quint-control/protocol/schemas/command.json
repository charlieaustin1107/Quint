{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command.json",
  "title": "Command",
  "description": "Asks the engine to do something. Risk-raising commands need two steps: send it, get needs_confirm with a one-time token, show the owner a confirm screen, then send the same command again with confirmToken (and typedConfirm when asked). Sent by the website.",
  "type": "object",
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "data"
  ],
  "additionalProperties": false,
