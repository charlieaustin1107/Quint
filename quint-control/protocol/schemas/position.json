{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "position.json",
  "title": "Position update",
  "description": "A position opened, changed or closed (Flat). Sent by the engine.",
  "type": "object",
  "required": [
    "v",
    "type",
    "seq",
    "ts",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "$ref": "common.json#/$defs/version"
    },
    "type": {
      "const": "position"
    },
    "seq": {
      "$ref": "common.json#/$defs/seq"
    },
    "ts": {
      "$ref": "common.json#/$defs/ts"
    },
    "data": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "common.json#/$defs/accountName"
        },
        "instrument": {
          "$ref": "common.json#/$defs/instrument"
        },
        "marketPosition": {
          "$ref": "common.json#/$defs/marketPosition"
        },
        "quantity": {
          "$ref": "common.json#/$defs/qty"
        },
        "avgPrice": {
          "$ref": "common.json#/$defs/nullablePrice"
        },
        "unrealizedPnl": {
          "$ref": "common.json#/$defs/money"
        },
        "openedAt": {
          "$ref": "common.json#/$defs/nullableTs"
        },
        "botId": {
          "$ref": "common.json#/$defs/nullableBotId"
        },
        "stop": {
          "$ref": "common.json#/$defs/nullablePrice"
        },
        "target": {
          "$ref": "common.json#/$defs/nullablePrice"
        },
        "protected": {
          "type": "boolean",
          "description": "True when a working stop at the broker covers the whole position."
        },
        "groupId": {
          "$ref": "common.json#/$defs/nullableId"
        }
      },
      "required": [
        "account",
        "instrument",
        "marketPosition",
        "quantity",
        "avgPrice",
        "unrealizedPnl",
        "openedAt",
        "botId",
        "stop",
        "target",
        "protected",
        "groupId"
      ],
      "additionalProperties": false
    }
  }
}
